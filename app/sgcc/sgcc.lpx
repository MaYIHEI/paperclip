#!name=网上国网签到
#!desc=版本 2026-10-16.r7 · 每天 8:30 自动登录并签到,无需抓包。在插件设置填手机号和密码;首次登录按通知把短信验证码填进来再手动运行一次。🧪 待验证
#!author=MaYIHEI
#!homepage=https://github.com/MaYIHEI/paperclip/tree/testing/app/sgcc
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/sgcc.png
#!loon_version = 3.5.1(983)
#!tag=签到

[Argument]
phone = input,"",tag=手机号,desc=网上国网登录手机号
password = input,"",tag=密码,desc=网上国网登录密码
sms = input,"",tag=短信验证码,desc=首次登录提示新设备验证时填写,再手动运行一次
debug = switch,false,tag=调试模式,desc=打印服务器返回

[Script]
cron "30 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/sgcc/sgcc.js", {${phone}, ${password}, ${sms}, ${debug}}) with tag="网上国网签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/sgcc.png", timeout=60
