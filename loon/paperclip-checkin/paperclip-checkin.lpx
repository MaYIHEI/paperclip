#!name=Paperclip · 签到合集
#!desc=paperclip 全部在用签到脚本的定时签到，每个脚本一个签到开关（默认全开，没抓 Cookie 的脚本会自动跳过）；打开统一通知后每天只弹一条汇总（默认 11:30，可改）；桌面小组件可以读签到结果、点按钮立即签到（只在小组件请求时运行，不影响定时签到）。Cookie 用「Paperclip · Cookie 抓取合集」插件获取，抓完关掉即可。
#!author=MaYIHEI
#!homepage=https://github.com/MaYIHEI/paperclip/tree/testing/loon/paperclip-checkin
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png
#!loon_version = 3.5.1(983)
#!tag=签到

[Argument]
merge = switch,true,tag=【统一通知】每天一条汇总,desc=打开后各脚本不再单独弹通知，到汇总时间发一条汇总；关闭则各自通知
summary_cron = input,"30 11 * * *",type=string,tag=【统一通知】汇总时间,desc=cron 写法「分 时 * * *」：默认 30 11 * * * 是每天 11:30，改成 0 21 * * * 就是每天 21:00。建议不早于 10:30，那时大部分脚本已签完；写错了汇总不会运行，签到不受影响
tenvideo = switch,true,tag=【腾讯视频】签到
mihoyo = switch,true,tag=【米游社】签到
qqmusic = switch,true,tag=【QQ 音乐】签到与任务
lhtj_app = switch,true,tag=【龙湖天街 App】签到
nodeseek = switch,true,tag=【NodeSeek】签到
weibotalk = switch,true,tag=【微博超话】签到
pan1 = switch,true,tag=【123网盘社区】签到
baidunetdisk = switch,true,tag=【百度网盘】成长值签到
mishop = switch,true,tag=【小米商城】签到
cmcc = switch,true,tag=【中国移动】签到
heybox = switch,true,tag=【小黑盒】签到
milottery = switch,true,tag=【小米抽奖】签到
sgcc = switch,true,tag=【网上国网】签到
dreame = switch,true,tag=【追觅】签到
linghu = switch,true,tag=【灵狐灵购】签到
newmixc = switch,true,tag=【一点万象】签到
laifen = switch,true,tag=【徕芬】签到
agentrouter = switch,true,tag=【AgentRouter】签到
youpin = switch,true,tag=【小米有品】签到
tingtingfm = switch,true,tag=【听听FM】签到
wanda = switch,true,tag=【万达电影】签到
wps = switch,true,tag=【WPS】签到与福利
camscanner = switch,true,tag=【扫描全能王】抽奖
huisheng = switch,true,tag=【惠省红包墙】领券
tuhu = switch,true,tag=【途虎养车】签到
haidilao = switch,true,tag=【海底捞】签到
miniso = switch,true,tag=【名创优品】签到
longde = switch,true,tag=【龙德广场】签到
bhg = switch,true,tag=【北京华联】签到
wedome = switch,true,tag=【味多美】签到
lhtj = switch,true,tag=【龙湖天街】签到
ppmt = switch,true,tag=【泡泡玛特】签到
linli = switch,true,tag=【林里】签到
push_key = input,"",tag=【小组件推送】推送密钥,desc=选填。填「复制 Loon 插件参数」里 push_key= 后面的值；发送密钥需勾选 widgets:reload、activities:start、activities:read-state、activities:update、activities:end 五项；留空则不推送，汇总照常；推送跟着签到汇总走，需打开「统一通知」
widget_targets = input,"",tag=【小组件推送】小组件 ID,desc=选填。填 widget_targets= 后面的值，多个用英文逗号分隔
activity_start_target = input,"",tag=【小组件推送】实时活动 ID,desc=选填。填 activity_start_target= 后面的值；填了会在锁屏开启或更新当天的签到实时活动
template_version = input,"",tag=【小组件推送】实时活动模板版本,desc=选填。填 template_version= 后面的值，和实时活动 ID 一起填

[Script]
# 签到汇总：按「汇总时间」每天一条通知（「统一通知」打开时）；填了小组件推送参数会顺带刷新小组件
cron ${summary_cron} then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/summary/summary.js", {${weibotalk}, ${tenvideo}, ${mihoyo}, ${newmixc}, ${mishop}, ${milottery}, ${youpin}, ${lhtj_app}, ${qqmusic}, ${wanda}, ${tingtingfm}, ${wps}, ${camscanner}, ${dreame}, ${linghu}, ${nodeseek}, ${pan1}, ${agentrouter}, ${sgcc}, ${cmcc}, ${heybox}, ${baidunetdisk}, ${laifen}, ${ppmt}, ${tuhu}, ${haidilao}, ${huisheng}, ${miniso}, ${longde}, ${lhtj}, ${wedome}, ${bhg}, ${linli}, ${push_key}, ${widget_targets}, ${activity_start_target}, ${template_version}}) with tag="签到汇总", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", timeout=60, enable=${merge}

# 定时签到：每个脚本按自己的时间跑，跟随各自的签到开关
cron "10 0 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/tenvideo/tenvideo.js", {${merge}}) with tag="腾讯视频签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/tenvideo.png", enable=${tenvideo}
cron "13 6 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/mihoyo/mihoyo.js", {${merge}}) with tag="米游社签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mihoyo.png", enable=${mihoyo}
cron "30 7 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/qqmusic/qqmusic.js", {${merge}}) with tag="QQ 音乐每日任务", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/qqmusic.png", enable=${qqmusic}
cron "* 9-10 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/qqmusic/qqmusic.js", {${merge}}) with tag="QQ 音乐定时金币", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/qqmusic.png", enable=${qqmusic}
cron "5 0,8,12,16,20,22 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/qqmusic/qqmusic.js", {${merge}}) with tag="QQ 音乐红包雨", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/qqmusic.png", enable=${qqmusic}
cron "0-59/19 8-10 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/lhtj/lhtj.js", {${merge}}) with tag="龙湖天街 App 签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/lhtj.png", enable=${lhtj_app}
cron "0 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/nodeseek/nodeseek.js", {${merge}}) with tag="NodeSeek 签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/nodeseek.png", enable=${nodeseek}
cron "0 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/weibotalk/weibotalk.js", {${merge}}) with tag="微博超话签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/weibo.png", enable=${weibotalk}
cron "10 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/pan1/pan1.js", {${merge}}) with tag="123网盘社区签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/pan1.png", enable=${pan1}
cron "15 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/baidunetdisk/baidunetdisk.js", {${merge}}) with tag="百度网盘成长值签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/baidunetdisk.png", enable=${baidunetdisk}
cron "15 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/mishop/mishop.js", {${merge}}) with tag="小米商城签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png", enable=${mishop}
cron "20 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/cmcc/cmcc.js", {${merge}}) with tag="中国移动签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/cmcc.png", timeout=60, enable=${cmcc}
cron "20 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/heybox/heybox.js", {${merge}}) with tag="小黑盒签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/heybox.png", enable=${heybox}
cron "30 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/milottery/milottery.js", {${merge}}) with tag="小米抽奖签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png", timeout=360, enable=${milottery}
cron "30 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/sgcc/sgcc.js", {${merge}}) with tag="网上国网签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/sgcc.png", timeout=60, enable=${sgcc}
cron "33 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/dreame/dreame.js", {${merge}}) with tag="追觅签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/dreame.png", enable=${dreame}
cron "33 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/linghu/linghu.js", {${merge}}) with tag="灵狐灵购签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/linghu.png", enable=${linghu}
cron "37 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/newmixc/newmixc.js", {${merge}}) with tag="一点万象签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/newmixc.png", enable=${newmixc}
cron "40 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/laifen/laifen.js", {${merge}}) with tag="徕芬签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/laifen.png", enable=${laifen}
cron "0 9 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/agentrouter/agentrouter.js", {${merge}}) with tag="AgentRouter 签到", img_url="https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/agentrouter/icon.png", timeout=300, enable=${agentrouter}
cron "5 9 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/youpin/youpin.js", {${merge}}) with tag="小米有品签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/youpin.png", enable=${youpin}
cron "20 9 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/tingtingfm/tingtingfm.js", {${merge}}) with tag="听听FM 签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/tingtingfm.png", enable=${tingtingfm}
cron "20 9 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/wanda/wanda.js", {${merge}}) with tag="万达电影签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wanda.png", enable=${wanda}
cron "0 10 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/wps/wps.js", {${merge}}) with tag="WPS 签到与福利", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wps.png", enable=${wps}
cron "15 10 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/camscanner/camscanner.js", {${merge}}) with tag="扫描全能王抽奖", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/camscanner.png", enable=${camscanner}
cron "5 0 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/huisheng/huisheng.js", {${merge}}) with tag="惠省红包墙领券", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/huisheng.png", enable=${huisheng}
cron "17 7 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/tuhu/tuhu.js", {${merge}}) with tag="途虎养车签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/tuhu.png", enable=${tuhu}
cron "23 7 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/haidilao/haidilao.js", {${merge}}) with tag="海底捞签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/haidilao.png", enable=${haidilao}
cron "37 7 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/miniso/miniso.js", {${merge}}) with tag="名创优品签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/miniso.png", enable=${miniso}
cron "5 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/longde/longde.js", {${merge}}) with tag="龙德广场签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/longde.png", enable=${longde}
cron "8 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/bhg/bhg.js", {${merge}}) with tag="北京华联签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/bhg.png", enable=${bhg}
cron "10 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/wedome/wedome.js", {${merge}}) with tag="味多美签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wedome.png", enable=${wedome}
cron "0 9 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/lhtj/lhtj.js", {${merge}}) with tag="龙湖天街签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/lhtj.png", enable=${lhtj}
cron "0 9 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/ppmt/ppmt.js", {${merge}}) with tag="泡泡玛特签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/popmart.png", enable=${ppmt}
cron "0 10 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/linli/linli.js", {${merge}}) with tag="林里签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/linli.png", enable=${linli}

# ===== 以下只给桌面小组件用，不用小组件可以忽略 =====
# 只在小组件请求 1.1.1.1/checkin/... 时运行，不会按时间触发，也不影响上面的定时签到
# 签到数据：返回全部脚本的登记信息和签到结果 JSON，只读，不签到
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/checkin\/all(\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/summary/summary.js") with tag="小组件 · 数据", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", timeout=10
# 立即签到：小组件点按钮时现跑一次该脚本，跟随各自的签到开关；跑得久的脚本没有
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/checkin\/tenvideo(\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/tenvideo/tenvideo.js", {${merge}}) with tag="小组件 · 腾讯视频", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", timeout=60, enable=${tenvideo}
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/checkin\/mihoyo(\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/mihoyo/mihoyo.js", {${merge}}) with tag="小组件 · 米游社", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", timeout=60, enable=${mihoyo}
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/checkin\/nodeseek(\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/nodeseek/nodeseek.js", {${merge}}) with tag="小组件 · NodeSeek", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", timeout=60, enable=${nodeseek}
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/checkin\/pan1(\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/pan1/pan1.js", {${merge}}) with tag="小组件 · 123网盘社区", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", timeout=60, enable=${pan1}
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/checkin\/baidunetdisk(\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/baidunetdisk/baidunetdisk.js", {${merge}}) with tag="小组件 · 百度网盘", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", timeout=60, enable=${baidunetdisk}
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/checkin\/mishop(\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/mishop/mishop.js", {${merge}}) with tag="小组件 · 小米商城", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", timeout=60, enable=${mishop}
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/checkin\/cmcc(\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/cmcc/cmcc.js", {${merge}}) with tag="小组件 · 中国移动", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", timeout=60, enable=${cmcc}
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/checkin\/heybox(\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/heybox/heybox.js", {${merge}}) with tag="小组件 · 小黑盒", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", timeout=60, enable=${heybox}
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/checkin\/sgcc(\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/sgcc/sgcc.js", {${merge}}) with tag="小组件 · 网上国网", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", timeout=60, enable=${sgcc}
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/checkin\/dreame(\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/dreame/dreame.js", {${merge}}) with tag="小组件 · 追觅", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", timeout=60, enable=${dreame}
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/checkin\/linghu(\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/linghu/linghu.js", {${merge}}) with tag="小组件 · 灵狐灵购", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", timeout=60, enable=${linghu}
