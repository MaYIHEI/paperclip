#!name = 哈啰净化
#!desc = 净化弹窗、首页推荐流、借钱入口与会员领券横条，隐藏我的页推广宫格、推荐、奖励金、接单券提醒及钱包金融整排（转自 ZenmoFeiShi/Qx helloobike.snippet 2026-10-23）
#!author = TG@ZenMoFiShi
#!homepage = https://github.com/ZenmoFeiShi/Qx
#!loon_version = 3.5.1(983)

[Rewrite]
request if ${url} ~= /^https?:\/\/api-htp\.beizi\.biz\/mb\/sdk0\/json(?:\?|$)/ then reject(200)
request if ${url} ~= /^https?:\/\/adservice\.sigmob\.cn\/(?:hb\/v2\/ad|ad\/v4)(?:\?|$)/ then reject(200)
request if ${url} ~= /^https?:\/\/tm\.sigmob\.cn\/(?:waterfall\/v1|strategy\/v6)(?:\?|$)/ then reject(200)
request if ${url} ~= /^https?:\/\/(?:mi|v2mi)\.gdt\.qq\.com\/(?:gdt_mview\.fcg|server_bidding2)(?:\?|$)/ then reject(200)

[Script]
request if ${url} ~= /^https:\/\/resource\.51downapp\.cn\/f414fbc17c411b4e986ba8891c738a49\.json\?(?:[^#]*&)?md5=e5230c919f7e3f3af3256161fbfaa0e2&(?:[^#]*&)?hbe_qx_ui=1\.3$/ then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/testing/loon/hellobike/easybike-ad.js") with tag="哈啰钱包模板"
response if ${url} ~= /^https:\/\/api\.hellobike\.com(?::443)?\/secretkey(?:\?|$)/ then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/testing/loon/hellobike/easybike-ad.js") with requires_body=true, tag="哈啰密钥捕获"
response if ${url} ~= /^https?:\/\/(?:api|marketingapi|entertainment)\.hellobike\.com(?::\d+)?\/api(?:\?|$)/ then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/testing/loon/hellobike/easybike-ad.js") with requires_body=true, tag="哈啰净化"

[MITM]
hostname = api.hellobike.com, marketingapi.hellobike.com, entertainment.hellobike.com, api-htp.beizi.biz, adservice.sigmob.cn, tm.sigmob.cn, mi.gdt.qq.com, v2mi.gdt.qq.com, resource.51downapp.cn
