#!name=Paperclip · Cookie 抓取合集
#!desc=一键抓取 paperclip 仓库全部签到脚本的 Cookie（含已归档,共 25 个），每个脚本一个独立开关（默认全关，按需打开）。仅含「抓取」规则，不含 cron 签到——cron 仍按各脚本 README 单独配置。打开对应开关后，进入相应 App/小程序的签到页触发即可，收到「✅ <名称> Cookie 获取成功」通知即成功。
#!author=MaYIHEI
#!homepage=https://github.com/MaYIHEI/paperclip
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip.png
#!loon_version = 3.5.1(983)
#!tag=签到, Cookie

[Argument]
ppmt = switch,false,tag=泡泡玛特,desc=打开泡泡玛特小程序进会员页触发(详见 README)
tuhu = switch,false,tag=途虎养车,desc=打开途虎养车小程序进签到页触发(详见 README)
haidilao = switch,false,tag=海底捞,desc=打开海底捞小程序进签到页触发(详见 README)
huisheng = switch,false,tag=惠省红包墙,desc=打开惠省小程序进红包墙触发(详见 README)
miniso = switch,false,tag=名创优品,desc=打开名创优品小程序进会员页触发(详见 README)
longde = switch,false,tag=龙德广场,desc=打开龙德广场小程序进签到页触发(与北京华联同会员体系,二选一;两个都开只有龙德生效)
lhtj = switch,false,tag=龙湖天街(小程序),desc=打开龙湖天街小程序进签到页触发(详见 README)
songshan = switch,false,tag=松山棉店,desc=打开松山棉店小程序进签到页触发(详见 README)
wedome = switch,false,tag=味多美,desc=打开味多美小程序进「我的」页触发(详见 README)
bhg = switch,false,tag=北京华联,desc=打开 BHG Mall 小程序进签到页触发(与龙德广场同会员体系,二选一;两个都开只有龙德生效)
weibotalk = switch,false,tag=微博超话,desc=微博 App 进超话/签到触发(详见 README)
mihoyo = switch,false,tag=米游社,desc=米游社 App 进社区页触发(详见 README)
tenvideo = switch,false,tag=腾讯视频,desc=微信小程序「腾讯视频」打开触发(详见 README)
newmixc = switch,false,tag=一点万象,desc=一点万象 App 进会员页触发(详见 README)
mishop = switch,false,tag=小米商城,desc=小米商城 App 进米金签到页触发(详见 README)
youpin = switch,false,tag=小米有品,desc=小米有品 App 进「我的/红包」触发(详见 README)
wanda = switch,false,tag=万达电影,desc=万达电影 App 进「我的」页触发(详见 README)
qqmusic = switch,false,tag=QQ音乐,desc=QQ 音乐 App 进绿钻会员中心触发(详见 README)
lhtj_app = switch,false,tag=龙湖天街(App),desc=龙湖天街 App 进签到页触发(APP 端受顶象风控,详见 README)
bibisheng = switch,false,tag=笔笔省(已归档),desc=微信支付笔笔省,已归档(7h TTL 无法续期)
casetify = switch,false,tag=CASETiFY(已归档),desc=CASETiFY 小程序,已归档(token 续期绑 wx.login)
topsports = switch,false,tag=滔搏运动(已归档),desc=滔搏运动小程序,已归档(双 auth 撑不过 24h)
lvcchong = switch,false,tag=驴充充(小程序·已归档),desc=驴充充小程序版,已归档(token<38min)
lvcchong_app = switch,false,tag=驴充充(App·已归档),desc=驴充充 App 版,已归档(refreshToken~20min)

[Script]
response if ${url} ~= /^https:\/\/popvip\.paquapp\.com\/miniapp\/v2\/(svip_lite\/user_info|wechat_message\/template_info)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/ppmt/ppmt.js") with tag="泡泡玛特 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/popmart.png", requires_body=true, enable=${ppmt}
request if ${url} ~= /https:\/\/api\.tuhu\.cn\/User\/(GetMemberSignInInfoAsync|GetRightsList)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/tuhu/tuhu.js") with tag="途虎养车 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/tuhu.png", enable=${tuhu}
request if ${url} ~= /^https:\/\/superapp-public\.kiwa-tech\.com\/activity\/wxapp\/signin\/(query|querySite|querySwitch|queryFragment|signin)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/haidilao/haidilao.js") with tag="海底捞 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/haidilao.png", enable=${haidilao}
request if ${url} ~= /^https:\/\/media\.meituan\.com\/fulishemini\/couponActivity\/listActivityCoupon/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/huisheng/huisheng.cookie.js") with tag="惠省红包墙 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/huisheng.png", requires_body=true, enable=${huisheng}
request if ${url} ~= /^https:\/\/member-center\.miniso\.com\/userinfo\/userinfo\/GetUserInfoV3/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/miniso/miniso.js") with tag="名创优品 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/miniso.png", enable=${miniso}
request if ${url} ~= /https:\/\/a\.china-smartech\.com\/restful\/mall\/\d+\/checkInForm/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/longde/longde.js") with tag="龙德广场 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/longde.png", enable=${longde}
request if ${url} ~= /^https:\/\/gw2c-hw-open\.longfor\.com\/lmarketing-task-api-mvc-prod\/openapi\/task\/v1\/signature\/clock$/i && ${request.header['x-lf-channel']} == "C2" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/lhtj/lhtj.js") with tag="龙湖天街 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/lhtj.png", enable=${lhtj}
request if ${url} ~= /^https:\/\/xapi\.weimob\.com\/api3\/onecrm\/mactivity\/sign\/misc\/sign\/activity\/(c\/signMainInfo|core\/c\/(getActivityInfo|sign))/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/songshan/songshan.js") with tag="松山棉店 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/songshan.png", requires_body=true, enable=${songshan}
response if ${url} ~= /^https:\/\/scrm-b\.zjian\.net\/api\/member\/(minaLogin|find)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/wedome/wedome.js") with tag="味多美 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wedome.png", requires_body=true, enable=${wedome}
request if ${url} ~= /https:\/\/a\.china-smartech\.com\/restful\/mall\/\d+\/checkInForm/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/bhg/bhg.js") with tag="北京华联 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/bhg.png", enable=${bhg}
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/(statuses\/container_timeline_topicsub|page\/button)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/weibotalk/weibotalk.cookie.js") with tag="微博超话 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/weibo.png", requires_body=true, enable=${weibotalk}
response if ${url} ~= /^https:\/\/bbs-api\.miyoushe\.com\/(apihub|user|misc)\//i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/mihoyo/mihoyo.cookie.js") with tag="米游社 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mihoyo.png", requires_body=true, enable=${mihoyo}
request if ${url} ~= /^https:\/\/pbaccess\.video\.qq\.com\//i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/tenvideo/tenvideo.js") with tag="腾讯视频 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/tenvideo.png", enable=${tenvideo}
request if ${url} ~= /^https:\/\/app\.mixcapp\.com\/mixc\/api\/v4\/member\/getPersonalData/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/newmixc/newmixc.cookie.js") with tag="一点万象 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/newmixc.png", enable=${newmixc}
request if ${url} ~= /^https:\/\/shop-api\.retail\.mi\.com\/mtop\/mf\/act\/infinite\/(do|done)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/mishop/mishop.cookie.js") with tag="小米商城 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png", enable=${mishop}
request if ${url} ~= /^https:\/\/m\.xiaomiyoupin\.com\/mtop\/act\/redPacketSign\/getActInfo/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/youpin/youpin.js") with tag="有品 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/youpin.png", enable=${youpin}
request if ${url} ~= /^https:\/\/user-api-prd-mx\.wandafilm\.com\/user\/user_info/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wanda/wanda.cookie.js") with tag="万达电影 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wanda.png", enable=${wanda}
request if ${url} ~= /^https:\/\/u6\.y\.qq\.com\/cgi-bin\/musics\.fcg\?.*(EveryDaySignLvzScore|GetSignInSummary)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/qqmusic/qqmusic.js") with tag="QQ音乐 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/qqmusic.png", requires_body=true, enable=${qqmusic}
request if ${url} ~= /^https:\/\/gw2c-hw-open\.longfor\.com\/lmarketing-task-api-mvc-prod\/openapi\/task\/v1\/signature\/clock$/i && ${request.header['x-lf-channel']} == "L0" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/lhtj/lhtj.js") with tag="龙湖App Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/lhtj.png", enable=${lhtj_app}
request if ${url} ~= /^https:\/\/discount\.wxpapp\.wechatpay\.cn\/txbbs-mall\/coupon\/(querydailygiftcoupons|claimdailygiftcoupon)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/bibisheng/bibisheng.cookie.js") with tag="笔笔省 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/bibisheng.png", enable=${bibisheng}
response if ${url} ~= /^https:\/\/mini-app-api\.casetify\.cn\/api\/v4\/estore\/member\/checkWebToken/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/casetify/casetify.js") with tag="CASETiFY Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/casetify.png", requires_body=true, enable=${casetify}
request if ${url} ~= /^https:\/\/m\.topsports\.com\.cn\/h5\/act\/signIn\/actInfo/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/topsports/topsports.js") with tag="滔搏 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/topsports.png", enable=${topsports}
request if ${url} ~= /^https:\/\/wxmall\.topsports\.com\.cn\/shopMember\//i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/topsports/topsports.js") with tag="滔搏 Auth", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/topsports.png", enable=${topsports}
response if ${url} ~= /^https:\/\/m\.topsports\.com\.cn\//i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/topsports/topsports.js") with tag="滔搏 H5", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/topsports.png", enable=${topsports}
response if ${url} ~= /^https:\/\/appapi\.lvcchong\.com\/getUnionInfo/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/lvcchong/lvcchong.js") with tag="驴充充 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/lvcchong.png", requires_body=true, enable=${lvcchong}
response if ${url} ~= /^https:\/\/appapi\.lvcchong\.com\/accessToken\/refresh\//i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/lvcchong/lvcchong.js") with tag="驴充充 Auth", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/lvcchong.png", requires_body=true, enable=${lvcchong}
request if ${url} ~= /^https:\/\/appapi\.lvcchong\.com\/(accessToken\/refresh|appBaseApi\/h5\/accessEntrance)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/lvcchong/lvcchong.js") with tag="驴充充 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/lvcchong.png", requires_body=true, enable=${lvcchong_app}
response if ${url} ~= /^https:\/\/appapi\.lvcchong\.com\/(accessToken\/refresh|appBaseApi\/h5\/accessEntrance)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/lvcchong/lvcchong.js") with tag="驴充充 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/lvcchong.png", requires_body=true, enable=${lvcchong_app}

[MITM]
hostname = popvip.paquapp.com, api.tuhu.cn, superapp-public.kiwa-tech.com, media.meituan.com, member-center.miniso.com, a.china-smartech.com, gw2c-hw-open.longfor.com, xapi.weimob.com, scrm-b.zjian.net, api.weibo.cn, bbs-api.miyoushe.com, pbaccess.video.qq.com, app.mixcapp.com, shop-api.retail.mi.com, m.xiaomiyoupin.com, user-api-prd-mx.wandafilm.com, u6.y.qq.com, discount.wxpapp.wechatpay.cn, mini-app-api.casetify.cn, m.topsports.com.cn, wxmall.topsports.com.cn, appapi.lvcchong.com
