#!name=Paperclip · Cookie 抓取合集
#!desc=抓取 paperclip 全部在用签到脚本的 Cookie，每个脚本一个开关（默认关闭）。打开要用的脚本进对应页面，收到「✅ <名称> Cookie 获取成功」后关掉本插件，避免一直解密这些域名。签到用「Paperclip · 签到合集」。
#!author=MaYIHEI
#!homepage=https://github.com/MaYIHEI/paperclip/tree/testing/loon/paperclip-cookie
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-cookie.png
#!loon_version = 3.5.1(983)
#!tag=签到, Cookie

[Argument]
weibotalk = switch,false,tag=【微博超话】抓取,desc=触发页面见该脚本 README
tenvideo = switch,false,tag=【腾讯视频】抓取,desc=触发页面见该脚本 README
mihoyo = switch,false,tag=【米游社】抓取,desc=触发页面见该脚本 README
newmixc = switch,false,tag=【一点万象】抓取,desc=触发页面见该脚本 README
mishop = switch,false,tag=【小米商城】抓取,desc=触发页面见该脚本 README
milottery = switch,false,tag=【小米抽奖】抓取,desc=触发页面见该脚本 README
youpin = switch,false,tag=【小米有品】抓取,desc=触发页面见该脚本 README
lhtj_app = switch,false,tag=【龙湖天街 App】抓取,desc=触发页面见该脚本 README
qqmusic = switch,false,tag=【QQ音乐】抓取,desc=触发页面见该脚本 README
wanda = switch,false,tag=【万达电影】抓取,desc=触发页面见该脚本 README
tingtingfm = switch,false,tag=【听听FM】抓取,desc=触发页面见该脚本 README
wps = switch,false,tag=【WPS】抓取,desc=触发页面见该脚本 README
camscanner = switch,false,tag=【扫描全能王】抓取,desc=触发页面见该脚本 README
dreame = switch,false,tag=【追觅】抓取,desc=触发页面见该脚本 README
linghu = switch,false,tag=【灵狐灵购】抓取,desc=触发页面见该脚本 README
nodeseek = switch,false,tag=【NodeSeek】抓取,desc=触发页面见该脚本 README
pan1 = switch,false,tag=【123社区】抓取,desc=触发页面见该脚本 README
baidunetdisk = switch,false,tag=【百度网盘】抓取,desc=触发页面见该脚本 README
ppmt = switch,false,tag=【泡泡玛特】抓取,desc=触发页面见该脚本 README
tuhu = switch,false,tag=【途虎养车】抓取,desc=触发页面见该脚本 README
haidilao = switch,false,tag=【海底捞】抓取,desc=触发页面见该脚本 README
huisheng = switch,false,tag=【惠省红包墙】抓取,desc=触发页面见该脚本 README
miniso = switch,false,tag=【名创优品】抓取,desc=触发页面见该脚本 README
longde = switch,false,tag=【龙德广场】抓取,desc=与北京华联同一个抓取地址；两个都开只有龙德生效
lhtj = switch,false,tag=【龙湖天街】抓取,desc=触发页面见该脚本 README
songshan = switch,false,tag=【松山棉店】抓取,desc=触发页面见该脚本 README
wedome = switch,false,tag=【味多美】抓取,desc=触发页面见该脚本 README
bhg = switch,false,tag=【北京华联】抓取,desc=与龙德广场同一个抓取地址；两个都开只有龙德生效
linli = switch,false,tag=【林里】抓取,desc=触发页面见该脚本 README

[Script]
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/(statuses\/container_timeline_topicsub|page\/button)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/weibotalk/weibotalk.cookie.js") with tag="微博超话 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/weibo.png", requires_body=true, enable=${weibotalk}
request if ${url} ~= /^https:\/\/pbaccess\.video\.qq\.com\//i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/tenvideo/tenvideo.js") with tag="腾讯视频 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/tenvideo.png", enable=${tenvideo}
response if ${url} ~= /^https:\/\/api-takumi\.(miyoushe|mihoyo)\.com\/(binding\/api\/getUserGameRolesByStoken|event\/luna\/)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/mihoyo/mihoyo.cookie.js") with tag="米游社 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mihoyo.png", requires_body=true, enable=${mihoyo}
request if ${url} ~= /^https:\/\/app\.mixcapp\.com\/mixc\/api\/v4\/member\/getPersonalData/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/newmixc/newmixc.cookie.js") with tag="一点万象 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/newmixc.png", enable=${newmixc}
request if ${url} ~= /^https:\/\/shop-api\.retail\.mi\.com\/mtop\/mf\/act\/infinite\/(do|done)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/mishop/mishop.cookie.js") with tag="小米商城 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png", enable=${mishop}
request if ${url} ~= /^https:\/\/shop-api\.retail\.mi\.com\/mtop\/navi\/venue\/batch/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/milottery/milottery.js") with tag="小米抽奖 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png", requires_body=true, enable=${milottery}
request if ${url} ~= /^https:\/\/m\.xiaomiyoupin\.com\/mtop\/act\/redPacketSign\/getActInfo/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/youpin/youpin.js") with tag="有品 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/youpin.png", enable=${youpin}
request if ${url} ~= /^https:\/\/gw2c-hw-open\.longfor\.com\/lmarketing-task-api-mvc-prod\/openapi\/task\/v1\/signature\/clock$/i && ${request.header['x-lf-channel']} == "L0" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/lhtj/lhtj.js") with tag="龙湖App Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/lhtj.png", enable=${lhtj_app}
request if ${url} ~= /^https:\/\/u6\.y\.qq\.com\/cgi-bin\/musics\.fcg\?.*(EveryDaySignLvzScore|GetSignInSummary)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/qqmusic/qqmusic.js") with tag="QQ音乐 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/qqmusic.png", requires_body=true, enable=${qqmusic}
request if ${url} ~= /^https:\/\/user-api-prd-mx\.wandafilm\.com\/user\/user_info/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/wanda/wanda.cookie.js") with tag="万达电影 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wanda.png", enable=${wanda}
request if ${url} ~= /^https:\/\/xunting\.vbegin\.com\.cn\/sns\/app/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/tingtingfm/tingtingfm.js") with tag="听听FM Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/tingtingfm.png", enable=${tingtingfm}
request if ${url} ~= /^https:\/\/personal-act\.wps\.cn\/activity-rubik\/activity\/page_info/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/wps/wps.cookie.js") with tag="WPS Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wps.png", enable=${wps}
request if ${url} ~= /^https:\/\/api-cs\.intsig\.net\/user\/cs\/get_user_attribute/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/camscanner/camscanner.cookie.js") with tag="扫描全能王 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/camscanner.png", enable=${camscanner}
request if ${url} ~= /^https:\/\/cn-wxmall\.dreame\.tech\/main\/my\/info/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/dreame/dreame.js") with tag="追觅 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/dreame.png", requires_body=true, enable=${dreame}
request if ${url} ~= /^https:\/\/cn-yx-wxmall\.dreame\.tech\/main\/my\/info/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/linghu/linghu.js") with tag="灵狐灵购 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/linghu.png", requires_body=true, enable=${linghu}
request if ${url} ~= /^https:\/\/www\.nodeseek\.com\//i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/nodeseek/nodeseek.cookie.js") with tag="NodeSeek Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/nodeseek.png", enable=${nodeseek}
request if ${url} ~= /^https:\/\/pan1\.me\/(?:\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/pan1/pan1.js") with tag="123社区 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/pan1.png", enable=${pan1}
request if ${url} ~= /^https:\/\/pan\.baidu\.com\/coins\/taskcenter\/signinlist/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/app/baidunetdisk/baidunetdisk.js") with tag="百度网盘 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/baidunetdisk.png", enable=${baidunetdisk}
response if ${url} ~= /^https:\/\/popvip\.paquapp\.com\/miniapp\/v2\/(svip_lite\/user_info|wechat_message\/template_info)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/ppmt/ppmt.js") with tag="泡泡玛特 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/popmart.png", requires_body=true, enable=${ppmt}
request if ${url} ~= /https:\/\/api\.tuhu\.cn\/User\/(GetMemberSignInInfoAsync|GetRightsList)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/tuhu/tuhu.js") with tag="途虎养车 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/tuhu.png", enable=${tuhu}
request if ${url} ~= /^https:\/\/superapp-public\.kiwa-tech\.com\/activity\/wxapp\/signin\/(query|querySite|querySwitch|queryFragment|signin)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/haidilao/haidilao.js") with tag="海底捞 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/haidilao.png", enable=${haidilao}
request if ${url} ~= /^https:\/\/media\.meituan\.com\/fulishemini\/couponActivity\/listActivityCoupon/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/huisheng/huisheng.cookie.js") with tag="惠省红包墙 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/huisheng.png", requires_body=true, enable=${huisheng}
request if ${url} ~= /^https:\/\/member-center\.miniso\.com\/userinfo\/userinfo\/GetUserInfoV3/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/miniso/miniso.js") with tag="名创优品 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/miniso.png", enable=${miniso}
request if ${url} ~= /https:\/\/a\.china-smartech\.com\/restful\/mall\/\d+\/checkInForm/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/longde/longde.js") with tag="龙德广场 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/longde.png", enable=${longde}
request if ${url} ~= /^https:\/\/gw2c-hw-open\.longfor\.com\/lmarketing-task-api-mvc-prod\/openapi\/task\/v1\/signature\/clock$/i && ${request.header['x-lf-channel']} == "C2" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/lhtj/lhtj.js") with tag="龙湖天街 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/lhtj.png", enable=${lhtj}
request if ${url} ~= /^https:\/\/xapi\.weimob\.com\/api3\/onecrm\/mactivity\/sign\/misc\/sign\/activity\/(c\/signMainInfo|core\/c\/(getActivityInfo|sign))/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/songshan/songshan.js") with tag="松山棉店 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/songshan.png", requires_body=true, enable=${songshan}
response if ${url} ~= /^https:\/\/scrm-b\.zjian\.net\/api\/member\/(minaLogin|find)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/wedome/wedome.js") with tag="味多美 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wedome.png", requires_body=true, enable=${wedome}
request if ${url} ~= /https:\/\/a\.china-smartech\.com\/restful\/mall\/\d+\/checkInForm/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/bhg/bhg.js") with tag="北京华联 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/bhg.png", enable=${bhg}
request if ${url} ~= /^https:\/\/webapi\.qmai\.cn\/web\/(cmk-center\/sign\/(activityInfo|userSignStatistics|userSignRecordCalendar)|catering\/common\/common-info|mall-apiserver\/integral\/(home\/index|item\/goods(\/detail)?))/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/miniprogram/linli/linli.js") with tag="林里 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/linli.png", requires_body=true, enable=${linli}

[MITM]
hostname = api.weibo.cn, pbaccess.video.qq.com, vip.video.qq.com, api-takumi.miyoushe.com, api-takumi.mihoyo.com, app.mixcapp.com, shop-api.retail.mi.com, m.xiaomiyoupin.com, gw2c-hw-open.longfor.com, u6.y.qq.com, user-api-prd-mx.wandafilm.com, xunting.vbegin.com.cn, personal-act.wps.cn, api-cs.intsig.net, cn-wxmall.dreame.tech, cn-yx-wxmall.dreame.tech, www.nodeseek.com, pan1.me, pan.baidu.com, popvip.paquapp.com, api.tuhu.cn, superapp-public.kiwa-tech.com, media.meituan.com, member-center.miniso.com, a.china-smartech.com, xapi.weimob.com, scrm-b.zjian.net, webapi.qmai.cn
