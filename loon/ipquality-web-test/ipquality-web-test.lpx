#!name=节点 IP 质量检测 · 模块化网页测试
#!desc=独立测试版：从节点页保存目标节点，在 Rewrite v2 本地网页中按需运行独立检测模块；不修改现有 IP 质量检测插件。
#!openUrl=
#!author=MaYIHEI[https://github.com/MaYIHEI]
#!homepage=https://github.com/MaYIHEI/paperclip/tree/testing/loon/ipquality-web-test
#!loon_version=3.5.1(979)
#!tag=节点,IP,Rewrite v2,模块化网页
#!date=2026-08-03 23:00:00

[Rewrite]
response if ${url} ~= /^http:\/\/paperclip\.test\/ipquality(?:\?.*)?$/ then response.body.mock("html", `<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="color-scheme" content="light dark"><title>节点 IP 质量检测</title><style>:root{color-scheme:light dark;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text",sans-serif;background:#f2f2f7;color:#1c1c1e}*{box-sizing:border-box}body{margin:0;min-height:100vh;padding:max(18px,env(safe-area-inset-top)) 14px max(34px,env(safe-area-inset-bottom));background:#f2f2f7;-webkit-font-smoothing:antialiased}button,input{font:inherit}.shell{width:min(100%,720px);margin:auto}.top{display:flex;justify-content:space-between;gap:12px;margin:4px 2px 18px}h1{margin:0;font-size:22px}.muted{color:#6e6e73;font-size:12px;line-height:1.5}.badge{padding:5px 9px;border-radius:99px;background:#e4f1ff;color:#0874dc;font-size:11px;height:max-content}.panel,.result{overflow:hidden;margin-bottom:14px;border-radius:20px;background:#fff;box-shadow:0 4px 20px rgba(0,0,0,.045)}.session{padding:15px 16px}.session b{display:block;margin-top:4px;overflow-wrap:anywhere}.head{display:flex;align-items:center;justify-content:space-between;margin:20px 3px 9px}.head h2{margin:0;font-size:16px}.opt{display:flex;align-items:center;justify-content:space-between;min-height:54px;padding:10px 15px;border-bottom:1px solid #ececf0;font-size:14px;font-weight:600}.opt:last-child{border:0}.sw{position:relative;width:48px;height:29px}.sw input{position:absolute;opacity:0}.track{position:absolute;inset:0;border-radius:99px;background:#d1d1d6}.track:after{content:"";position:absolute;top:2px;left:2px;width:25px;height:25px;border-radius:50%;background:#fff;box-shadow:0 1px 4px rgba(0,0,0,.24);transition:.18s}.sw input:checked+.track{background:#30d158}.sw input:checked+.track:after{transform:translateX(19px)}.actions{display:grid;grid-template-columns:1fr auto;gap:10px}.actions button{min-height:46px;border:0;border-radius:15px;padding:0 17px;font-weight:600}.run{background:#0a84ff;color:#fff}.clear{background:#e5e5ea;color:#1c1c1e}button:disabled{opacity:.55}.progress{margin:9px 3px 16px}.result summary{display:flex;align-items:center;justify-content:space-between;min-height:58px;padding:13px 15px;list-style:none}.result summary::-webkit-details-marker{display:none}.name{display:flex;align-items:center;gap:9px;font-size:14px;font-weight:600}.dot{width:9px;height:9px;border-radius:50%;background:#c7c7cc}.result[data-state=running] .dot{background:#ff9f0a}.result[data-state=success] .dot{background:#30d158}.result[data-state=error] .dot{background:#ff453a}.status{color:#8e8e93;font-size:11px}.result[data-state=success] .status{color:#16824f}.result[data-state=error] .status,.error{color:#d72f26}.content{padding:0 10px 12px;border-top:1px solid #ececf0}.frame{display:block;width:100%;min-height:220px;border:0}.empty,.error{padding:20px 16px;text-align:center;font-size:13px}@media(prefers-color-scheme:dark){:root,body{background:#000;color:#f2f2f7}.panel,.result{background:#1c1c1e;box-shadow:none}.muted{color:#a1a1a6}.badge{background:#102b45;color:#64b5ff}.opt,.content{border-color:#303034}.track{background:#48484a}.clear{background:#2c2c2e;color:#f2f2f7}.result[data-state=success] .status{color:#32d583}.result[data-state=error] .status,.error{color:#ff6961}}@media(max-width:430px){.actions{grid-template-columns:1fr}}</style></head><body><main class="shell"><header class="top"><div><h1>节点 IP 质量检测</h1><div class="muted">模块化网页测试 · 按需加载</div></div><span class="badge">Rewrite v2</span></header><section class="panel session"><span class="muted">当前检测会话</span><b id="session">正在读取…</b></section><div class="head"><h2>选择检测项目</h2><span class="muted" id="count"></span></div><section class="panel" id="options"></section><div class="actions"><button class="run" id="run">开始检测已选项目</button><button class="clear" id="clear">清空结果</button></div><div class="muted progress" id="progress">准备就绪</div><div class="head"><h2>检测结果</h2><span class="muted">每项可独立展开</span></div><section id="results"><div class="panel empty muted">选择项目后开始检测</div></section></main><script>(function(){var M=[["basic","基础信息",1],["types","IP 类型属性",1],["scores","风险评分",1],["factors","风险因素",0],["egress","出口分流",0],["bgp","BGP 信息",0],["bgppath","BGP 路径",0],["speed","三网真实测速",0],["inbound","外部探针入站路径",0],["ping","外部探针 Ping",0],["mtr","外部探针 MTR",0],["stability","HTTPS 稳定性",0],["media","流媒体与 AI",1],["regions","地区一致性",0],["status","数据状态",0]],q=new URLSearchParams(location.search),rid=q.get("run")||"",o=document.getElementById("options"),r=document.getElementById("results"),c=document.getElementById("count"),p=document.getElementById("progress"),b=document.getElementById("run"),x=document.getElementById("clear"),busy=false;try{var saved=JSON.parse(localStorage.getItem("paperclip.ipquality.web.modules")||"null");if(Array.isArray(saved))M.forEach(function(m){m[2]=saved.indexOf(m[0])>=0?1:0})}catch(e){}document.getElementById("session").textContent=rid?"会话 "+rid:"缺少会话，请返回 Loon 重新启动";b.disabled=!rid;M.forEach(function(m){var l=document.createElement("label");l.className="opt";l.innerHTML="<span>"+esc(m[1])+"</span><span class=\"sw\"><input type=\"checkbox\" data-id=\""+m[0]+"\""+(m[2]?" checked":"")+"><span class=\"track\"></span></span>";l.querySelector("input").onchange=function(e){m[2]=e.target.checked?1:0;save();count()};o.appendChild(l)});count();b.onclick=run;x.onclick=function(){if(!busy){r.innerHTML='<div class="panel empty muted">选择项目后开始检测</div>';p.textContent="结果已清空"}};function count(){c.textContent=M.filter(function(m){return m[2]}).length+" 项已开启"}function save(){try{localStorage.setItem("paperclip.ipquality.web.modules",JSON.stringify(M.filter(function(m){return m[2]}).map(function(m){return m[0]})))}catch(e){}}async function run(){if(busy||!rid)return;var s=M.filter(function(m){return m[2]});if(!s.length){p.textContent="请至少开启一个检测项目";return}busy=true;toggle(true);r.innerHTML="";s.forEach(card);var done=0,i=0;p.textContent="0/"+s.length+" 已完成 · 最多两个模块并发";async function worker(){while(i<s.length){var m=s[i++];await load(m);done++;p.textContent=done+"/"+s.length+" 已完成"}}try{await Promise.all([worker(),worker()]);p.textContent=s.length+" 项检测完成"}finally{busy=false;toggle(false);b.textContent="重新检测已选项目"}}function card(m){var d=document.createElement("details");d.className="result";d.dataset.id=m[0];d.dataset.state="running";d.innerHTML='<summary><span class="name"><span class="dot"></span>'+esc(m[1])+'</span><span class="status">等待执行</span></summary><div class="content"><p class="muted">模块进入队列后将自动开始。</p></div>';r.appendChild(d)}async function load(m){var d=r.querySelector('[data-id="'+m[0]+'"]'),st=d.querySelector(".status"),ct=d.querySelector(".content");st.textContent="检测中…";ct.innerHTML='<p class="muted">正在通过目标节点请求真实检测来源…</p>';try{var res=await fetch("/ipquality/api/"+m[0]+"?run="+encodeURIComponent(rid),{cache:"no-store",headers:{Accept:"application/json"}}),data=await res.json();if(!res.ok||!data.ok)throw new Error(data.error||"HTTP "+res.status);d.dataset.state="success";st.textContent=duration(data.elapsedMs);ct.innerHTML="";var f=document.createElement("iframe");f.className="frame";f.title=m[1]+"检测结果";f.setAttribute("sandbox","allow-same-origin allow-popups allow-popups-to-escape-sandbox");f.srcdoc=data.html;f.onload=function(){resize(f)};ct.appendChild(f);d.open=true}catch(e){d.dataset.state="error";st.textContent="失败";ct.innerHTML='<p class="error">'+esc(e&&e.message||"未知错误")+'</p>';d.open=true}}function resize(f){var n=0;function up(){try{var d=f.contentDocument,h=Math.max(d.body?d.body.scrollHeight:0,d.documentElement?d.documentElement.scrollHeight:0);if(h)f.style.height=h+12+"px"}catch(e){}if(++n<6)setTimeout(up,250)}up()}function toggle(v){b.disabled=v||!rid;x.disabled=v;o.querySelectorAll("input").forEach(function(e){e.disabled=v});b.textContent=v?"正在检测…":"开始检测已选项目"}function duration(v){v=Number(v);return Number.isFinite(v)?v>=1000?(v/1000).toFixed(v>=10000?1:2)+" 秒":Math.round(v)+" ms":"完成"}function esc(v){return String(v||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;")}})();</script></body></html>`, 200) | response.header.set("Content-Type", "text/html; charset=utf-8") | response.header.set("Cache-Control", "no-store, no-cache, must-revalidate") | response.header.set("Content-Security-Policy", "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'self'; frame-src 'self'; img-src data:") | response.header.set("X-Content-Type-Options", "nosniff")

[Script]
generic script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-test.js?ver=poc5, tag=节点 IP 质量检测 · 模块化网页测试, timeout=10, img-url=safari.system, enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/basic(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc5, tag=IP 检测接口 · 基础信息, timeout=65, requires-body=false, argument="basic", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/types(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc5, tag=IP 检测接口 · 类型属性, timeout=65, requires-body=false, argument="types", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/scores(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc5, tag=IP 检测接口 · 风险评分, timeout=65, requires-body=false, argument="scores", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/factors(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc5, tag=IP 检测接口 · 风险因素, timeout=65, requires-body=false, argument="factors", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/egress(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc5, tag=IP 检测接口 · 出口分流, timeout=65, requires-body=false, argument="egress", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/bgp(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc5, tag=IP 检测接口 · BGP 信息, timeout=65, requires-body=false, argument="bgp", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/bgppath(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc5, tag=IP 检测接口 · BGP 路径, timeout=65, requires-body=false, argument="bgppath", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/speed(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc5, tag=IP 检测接口 · 三网测速, timeout=65, requires-body=false, argument="speed", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/inbound(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc5, tag=IP 检测接口 · 入站路径, timeout=65, requires-body=false, argument="inbound", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/ping(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc5, tag=IP 检测接口 · Ping, timeout=65, requires-body=false, argument="ping", enable=true
