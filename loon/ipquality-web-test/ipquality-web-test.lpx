http-request ^http:\/\/paperclip\.test\/ipquality\/api\/status(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc5, tag=IP 检测接口 · 数据状态, timeout=65, requires-body=false, argument="status", enable=true
