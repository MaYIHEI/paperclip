http-request ^http:\/\/paperclip\.test\/ipquality\/api\/stability(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc5, tag=IP 检测接口 · HTTPS 稳定性, timeout=65, requires-body=false, argument="stability", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/media(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc5, tag=IP 检测接口 · 流媒体与 AI, timeout=65, requires-body=false, argument="media", enable=true
