#!name=节点 IP 质量检测 · 模块化网页测试
#!desc=独立测试版：从节点页保存目标节点，在 Rewrite v2 本地网页中按需运行独立检测模块；不修改现有 IP 质量检测插件。
#!openUrl=
#!author=MaYIHEI[https://github.com/MaYIHEI]
#!homepage=https://github.com/MaYIHEI/paperclip/tree/testing/loon/ipquality-web-test
#!loon_version=3.5.1(979)
#!tag=节点,IP,Rewrite v2,模块化网页
#!date=2026-08-03 23:00:00

[Rewrite]
response if ${url} ~= /^http:\/\/paperclip\.test\/ipquality(?:\?.*)?$/ then response.body.mock_file("html", "ipquality-web-viewer.html", 200) | response.header.set("Content-Type", "text/html; charset=utf-8") | response.header.set("Cache-Control", "no-store, no-cache, must-revalidate") | response.header.set("Content-Security-Policy", "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'self'; frame-src 'self'; img-src data:") | response.header.set("X-Content-Type-Options", "nosniff")

[Script]
generic script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-test.js?ver=poc4, tag=节点 IP 质量检测 · 模块化网页测试, timeout=10, img-url=safari.system, enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/basic(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc4, tag=IP 检测接口 · 基础信息, timeout=65, requires-body=false, argument="basic", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/types(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc4, tag=IP 检测接口 · 类型属性, timeout=65, requires-body=false, argument="types", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/scores(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc4, tag=IP 检测接口 · 风险评分, timeout=65, requires-body=false, argument="scores", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/factors(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc4, tag=IP 检测接口 · 风险因素, timeout=65, requires-body=false, argument="factors", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/egress(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc4, tag=IP 检测接口 · 出口分流, timeout=65, requires-body=false, argument="egress", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/bgp(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc4, tag=IP 检测接口 · BGP 信息, timeout=65, requires-body=false, argument="bgp", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/bgppath(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc4, tag=IP 检测接口 · BGP 路径, timeout=65, requires-body=false, argument="bgppath", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/speed(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc4, tag=IP 检测接口 · 三网测速, timeout=65, requires-body=false, argument="speed", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/inbound(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc4, tag=IP 检测接口 · 入站路径, timeout=65, requires-body=false, argument="inbound", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/ping(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc4, tag=IP 检测接口 · Ping, timeout=65, requires-body=false, argument="ping", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/mtr(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc4, tag=IP 检测接口 · MTR, timeout=65, requires-body=false, argument="mtr", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/stability(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc4, tag=IP 检测接口 · HTTPS 稳定性, timeout=65, requires-body=false, argument="stability", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/media(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc4, tag=IP 检测接口 · 流媒体与 AI, timeout=65, requires-body=false, argument="media", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/regions(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc4, tag=IP 检测接口 · 地区一致性, timeout=65, requires-body=false, argument="regions", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/status(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/testing/loon/ipquality-web-test/ipquality-web-module.js?ver=poc4, tag=IP 检测接口 · 数据状态, timeout=65, requires-body=false, argument="status", enable=true
